# Guide

guide: {
  metrics: count: entity: 2
  metrics: count: path: 2
  metrics: count: method: 2

  entity: analytics: {
    path: "/branch_aggregate/async/analytics": {
      op: create: method: *POST
    }
  }

  entity: status: {
    path: "/branch_aggregate/async/status/{job_id}": {
      rename: param: "job_id": *"id"
      op: load: method: *GET
    }
  }

}